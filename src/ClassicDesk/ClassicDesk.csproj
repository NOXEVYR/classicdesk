<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>0.11.11-dev</Version>
    <AssemblyName>ClassicDesk</AssemblyName>
    <StartupObject>ClassicDesk.ShellProgram</StartupObject>
    <ApplicationIcon>Assets/ClassicDesk.ico</ApplicationIcon>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <Deterministic>true</Deterministic>
    <PathMap>$(MSBuildProjectDirectory)=/_/ClassicDesk</PathMap>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="ShellProfileLibrary.cs;ShellLoginResume.cs" />
    <Compile Include="AppIcons.cs;ShellPreview.cs;ShellProfile.cs;ShellSettingsWindow.cs;ShellBackendPlan.cs;ShellBackendConfig.cs;ShellProgram.cs;ShellActivation.cs;ShellActivationHost.cs;ShellNativeController.cs;ShellNativePanel.cs" />
    <Resource Include="Assets/ClassicDesk.ico" />
  </ItemGroup>
  <ItemGroup><Resource Include="Assets/starlight-anime.png"/><Resource Include="Assets/skin-*.png"/></ItemGroup>
  <ItemGroup><Resource Include="Assets/brand-starlight.png" Link="Assets/brand-starlight.png"/></ItemGroup>
</Project>
